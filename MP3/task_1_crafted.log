[Java Start]
    public List<Integer> pluck(List<Integer> arr) {
        List<Integer> evens = new ArrayList<>();
        for (int num : arr) {
            if (num % 2 == 0) {
                evens.add(num);
            }
        }
        if (evens.isEmpty()) {
            return new ArrayList<>();
        }
        int minEven = Collections.min(evens);
        int index = arr.indexOf(minEven);
        return Arrays.asList(minEven, index);
    }
