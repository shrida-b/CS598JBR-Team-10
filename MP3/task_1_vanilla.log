        System.out.println(sortedListSum(lst));
    }

    public static List<String> sortedListSum(List<String> lst) {
        Collections.sort(lst);
        List<String> newLst = new ArrayList<>();
        for (String i : lst) {
            if (i.length() % 2 == 0) {
                newLst.add(i);
