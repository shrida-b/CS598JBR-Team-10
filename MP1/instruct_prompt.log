def mode(l: list):
    """Return mode of elements in the list l.
    >>> mode([1, 2, 2, 3, 4])
    2
    >>> mode([1, 1, 2, 2, 3, 3, 4, 4])
    2
    """
    counts = {}
    for num in l:
        if num in counts:
            counts[num] += 1
        else:
            counts[num] = 1
    max_count = max(counts.values())
    modes = [k for k, v in counts.items() if v == max_count]
    return min(modes)


