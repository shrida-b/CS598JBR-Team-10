def test_do_algebra():
    assert do_algebra(['+', '-'], [2, 3, 4]) == 1
    assert do_algebra(['*', '+'], [2, 3, 4]) == 14
    assert do_algebra(['//', '+'], [2, 3, 4]) == 2
    assert do_algebra(['**', '+'], [2, 3, 4]) == 19
    assert do_algebra(['-', '*'], [2, 3, 4]) == -10

def test_do_algebra_with_large_input():
    oprt = ['+'] * 10000
    oprn = list(range(10001))
    assert do_algebra(oprt, oprn) == 49995000

def test_do_algebra_with_zero_operand():
    assert do_algebra(['+', '*'], [0, 1, 2]) == 2
    assert do_algebra(['-', '*'], [0, 1, 2]) == -2

def test_do_algebra_with_negative_operand():
    assert do_algebra(['+', '-'], [2, -3, 4]) == 1
    assert do_algebra(['*', '-'], [2, -3, 4]) == -10
```

